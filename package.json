{
  "name": "commit-msg-lint",
  "version": "1.0.0",
  "description": "🔍 CLI that validates commit messages against conventional commit format",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "commit-msg-lint": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepare": "npm run build",
    "install-hook": "node dist/install-hook.js"
  },
  "keywords": [
    "commit",
    "lint",
    "conventional-commits",
    "git-hook",
    "husky",
    "commitlint",
    "validation"
  ],
  "author": "SMIT-LAD-CODER",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
